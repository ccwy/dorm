##############################################################################
#
#   Gradle start up script for POSIX generated by Gradle.
#
#   Important for running:
#
#   (1) You need a POSIX-compliant shell to run this script. If your /bin/sh is
#       noncompliant, but you have some other compliant shell, you can override
#       the shell used by setting the GRADLE_WRAPPER_SHELL environment variable.
#   (2) You need a Java installation to run Gradle. If JAVA_HOME is set, it
#       will use that. Otherwise, it will try to find java on the PATH.
#
##############################################################################

# Attempt to set APP_HOME

# Resolve links: $0 may be a link
app_path=$0

# Need this for daisy-chained symlinks.
while
    APP_HOME=${app_path%"${app_path##*/}"}  # leaves a trailing / even empty root
    APP_HOME=${APP_HOME:-"."}
    APP_HOME=${APP_HOME%/}/
    APP_BASE_NAME=${0##*/}
    # Resolve symlinks
    case "$(uname -s)" in
        Darwin*) app_path=$(readlink -f "$app_path") ;;
        Linux*)  app_path=$(readlink -f "$app_path") ;;
        FreeBSD*) app_path=$(readlink -f "$app_path") ;;
    esac
    [ -h "$app_path" ]
do
    app_path=$(readlink "$app_path")
done

# This is normally unused
# shellcheck disable=SC2034
APP_HOME=$( cd "${APP_HOME:-./}" > /dev/null && pwd -P ) || exit

# Use the maximum available, or set MAX_FD != -1 to use that value.
MAX_FD=maximum

warn () {
    echo "$*"
} >&2

die () {
    echo
    echo "$*"
    echo
    exit 1
} >&2

# OS specific support (must be 'true' or 'false').
cygwin=false
msys=false
darwin=false
nonstop=false
case "$( uname )" in                #(
  CYGWIN* )         cygwin=true  ;; #(
  Darwin* )         darwin=true  ;; #(
  MSYS* | MINGW* )  msys=true    ;; #(
  NonStop* )        nonstop=true ;;
esac

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar


# Determine the Java command to use to start the JVM.
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        # IBM's JDK on AIX uses strange locations for the executables
        JAVACMD=$JAVA_HOME/jre/sh/java
    else
        JAVACMD=$JAVA_HOME/bin/java
    fi
    if [ ! -x "$JAVACMD" ] ; then
        die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
else
    JAVACMD=java
    if ! command -v java >/dev/null 2>&1
    then
        die "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH.

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
fi

# Increase the maximum file descriptors if we can.
if ! "$cygwin" && ! "$darwin" && ! "$nonstop" ; then
    case $MAX_FD in #(
      max*)
        # In POSIX sh, ulimit -H is undefined. That's why the result is checked to see if it worked.
        # shellcheck disable=SC2039,SC3045
        MAX_FD=$( ulimit -H -n ) ||
            warn "Could not query maximum file descriptor limit"
      ;;
    esac
    case $MAX_FD in #(
      '' | soft) :;; #(
      *)
        # In POSIX sh, ulimit -n is undefined. That's why the result is checked to see if it worked.
        # shellcheck disable=SC2039,SC3045
        ulimit -n "$MAX_FD" ||
            warn "Could not set maximum file descriptor limit to $MAX_FD"
      ;;
    esac
fi

# Collect all arguments for the java command;
#   The following code is an adaptation of the code from https://stackoverflow.com/a/246128
#   to properly handle the case when APP_HOME contains spaces or special characters.
#
#   This is also necessary to properly handle the case when the script
#   is called from a symlink, and APP_HOME is the symlink target.
#
#  shellcheck disable=SC2086
eval set -- $DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS "\"-Dorg.gradle.appname=$APP_BASE_NAME\"" -classpath "\"$CLASSPATH\"" org.gradle.wrapper.GradleWrapperMain "$@"

# Stop when "xargs" is not available.
if ! command -v xargs >/dev/null 2>&1
then
    die "xargs is not available."
fi

# Use "xargs" to parse quoted args.
#
# With -n1 it outputs one arg per line, with the quotes and backslashes removed on the output.
#
# In Bourne shell (which is POSIX shell without xargs extensions),
# if there is no argument left, "xargs" does not output anything.
#
# In bash and zsh, "xargs" without arguments runs echo, which outputs a blank line.
# We handle this case by checking if the output is empty and if so, we skip the execution.
#
#shellcheck disable=SC2034
eval "xargs_output=\"\$( echo \"\$@\" | xargs -n1 )\""
if [ -n "$xargs_output" ]; then
    exec "$JAVACMD" "$@"
fi